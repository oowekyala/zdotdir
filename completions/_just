#compdef just

# Load the clap dynamic completer (once when loading this function)
source <(JUST_COMPLETE=zsh just)

_just() {
    local cmds
    cmds=(${(s: :)$(_call_program commands just --summary 2>/dev/null)})

    # Find the first recipe in the command line (single-word or module::subcommand)
    local recipe i
    for ((i = 2; i <= $#words; i++)); do
        if [[ ${cmds[(I)${words[i]}]} -gt 0 ]]; then
            recipe=${words[i]}
            break
        elif (( i < $#words )) && [[ ${cmds[(I)${words[i]}::${words[i+1]}]} -gt 0 ]]; then
            recipe="${words[i]}::${words[i+1]}"
            (( i++ ))
            break
        fi
    done

    if [[ -n $recipe ]]; then
        local recipe_fn="_just_${recipe//-/_}"
        recipe_fn="${recipe_fn//::/__}"
        if (( $+functions[$recipe_fn] )); then
            local _shift=$(( i - 1 ))
            shift $_shift words
            [[ $recipe = *::* ]] && (( CURRENT -= _shift ))
            $recipe_fn
            return $?
        fi
    fi

    # Fallback: clap-based dynamic completer
    _clap_dynamic_completer_just "$@"
}

compdef _just just
